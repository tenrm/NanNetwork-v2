rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // รายชื่ออีเมลผู้มีสิทธิ์แก้ไข: เอกสาร config/editors  { emails: ["a@x.com", ...] }
    function isEditor() {
      return request.auth != null
        && request.auth.token.email in get(/databases/$(database)/documents/config/editors).data.emails;
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if false;   // แก้รายชื่อผ่าน Firebase Console เท่านั้น
    }
    match /projects/{pid} {
      allow read: if true;     // ทุกคนดูได้
      allow write: if isEditor();
      match /{sub=**} {
        allow read: if true;
        allow write: if isEditor();
      }
    }
  }
}
